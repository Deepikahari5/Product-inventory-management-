          "raw": "{\n  \"name\": \"Electronics\",\n  \"description\": \"dup\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 409\", () => pm.response.to.have.status(409));",
              "pm.test(\"Has message\", () => pm.expect(pm.response.json().detail).to.include(\"already exists\"));"
            ]
          }
        }
      ]
    },
